# Mdeaver Charity API — Environment Variables
# Copy to .env and fill in real values

ADMIN_EMAIL=Mdeavercharityfoundation@outlook.com
RESEND_API_KEY=re_your_live_key_here
FROM_EMAIL=Mdeaver Charity Foundation <notifications@mdeavercharity.org>

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CORS allowed origins
ALLOWED_ORIGIN=https://www.mdeavercharity.com

# Local dev port
PORT=3000
